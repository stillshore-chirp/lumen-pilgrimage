{
  "name": "lumen-pilgrimage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm run validate:content && npm run validate:release && npm run validate:harness && npm run test:coast",
    "test:coast": "node --test scripts/coast-controls.test.mjs scripts/coast-terrain.test.mjs scripts/coast-acoustics.test.mjs",
    "test:coast:browser": "node --test scripts/coast-browser.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "validate:harness": "node scripts/validate-harness.mjs"
  },
  "dependencies": {
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "playwright": "1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
