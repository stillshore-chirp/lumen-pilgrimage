{
  "name": "lumen-pilgrimage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && npm run validate:harness && npm run test:coast && npm run test:monitor && npm run test:residence",
    "test:coast": "node --test scripts/coast-controls.test.mjs scripts/coast-terrain.test.mjs scripts/coast-acoustics.test.mjs",
    "test:coast:browser": "node --test scripts/coast-browser.test.mjs",
    "test:monitor": "node --test scripts/monitor-signaling.test.mjs scripts/monitor-session.test.mjs scripts/monitor-capture.test.mjs scripts/monitor-pose.test.mjs scripts/monitor-xr.test.mjs scripts/monitor-audio.test.mjs",
    "test:monitor:browser": "node --test scripts/monitor-browser.test.mjs",
    "test:residence": "node --test scripts/residence-navigation.test.mjs scripts/residence-audio.test.mjs",
    "test:residence:browser": "node --test scripts/residence-browser.test.mjs",
    "validate:harness": "node scripts/validate-harness.mjs"
  },
  "dependencies": {
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "playwright": "1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
